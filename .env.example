# Required: Your Anthropic API key for Claude 3.7
ANTHROPIC_API_KEY=your_api_key_here

# Storage Configuration
#-----------------------
# Path to store screenshots and reports
STORAGE_PATH=./storage
# Number of days to keep files before cleanup
STORAGE_RETENTION_DAYS=7
# Path specifically for reports
REPORTS_PATH=./storage/reports

# Claude API Configuration
#-------------------------
# Claude model to use (uncomment to change from default)
# MODEL=claude-3-7-sonnet-20240620
# Maximum tokens for Claude response
# MAX_TOKENS=4000

# Viewport Configuration
#-----------------------
# Default viewports can be overridden here
# MOBILE_WIDTH=375
# MOBILE_HEIGHT=667
# TABLET_WIDTH=768
# TABLET_HEIGHT=1024
# DESKTOP_WIDTH=1024
# DESKTOP_HEIGHT=768
# LARGE_WIDTH=1440
# LARGE_HEIGHT=900

# Browser Configuration
#----------------------
# Timeout for page load in milliseconds
# PAGE_LOAD_TIMEOUT=30000
# Time to wait after page load before capturing screenshot
# SCREENSHOT_DELAY=2000
# Whether to disable animations by default
# DISABLE_ANIMATIONS=false
# Whether to use enhanced stealth mode to bypass bot detection
# Uses playwright-extra-stealth for advanced protection against:
#  - WebGL fingerprinting
#  - Audio context fingerprinting
#  - Hardware concurrency spoofing
#  - Device memory spoofing
#  - Font enumeration protection
# STEALTH_MODE=false
# Custom user agent string
# USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Analysis Configuration
#-----------------------
# Focus areas (comma-separated list)
# FOCUS_AREAS=accessibility,branding,responsive,hierarchy,consistency
# Default output format (text, json, markdown)
# OUTPUT_FORMAT=text
# Whether to include code suggestions in analysis
# INCLUDE_CODE=false

# Feedback Loop Configuration
#---------------------------
# Default number of iterations
# FEEDBACK_LOOP_ITERATIONS=3
# Whether to run in non-interactive mode
# NON_INTERACTIVE=false 