# UILensAI v1.0.0 — Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED: Cloudflare Browser Rendering
# =============================================================================
# UILensAI uses Cloudflare Browser Rendering for all screenshots and crawling.
# 1. Go to https://dash.cloudflare.com → select your account
# 2. Copy your Account ID from the right sidebar
# 3. Go to https://dash.cloudflare.com/profile/api-tokens
# 4. Create a token with "Browser Rendering: Edit" permission

CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_BR_API_TOKEN=your_api_token

# =============================================================================
# REQUIRED: AI Provider API Key (at least one)
# =============================================================================
# OpenRouter is recommended — gives access to multiple AI models via one key.
# Get a key at https://openrouter.ai/keys

OPENROUTER_API_KEY=your_openrouter_key

# --- Alternative providers (optional, for multi-model analysis) ---
# ANTHROPIC_API_KEY=your_anthropic_key     # https://console.anthropic.com
# OPENAI_API_KEY=your_openai_key           # https://platform.openai.com
# GEMINI_API_KEY=your_google_key           # https://aistudio.google.com
# DEEPSEEK_API_KEY=your_deepseek_key       # https://platform.deepseek.com
# XAI_API_KEY=your_xai_key                 # https://console.x.ai

# =============================================================================
# OPTIONAL: Model Selection
# =============================================================================

# Strategy: 'single', 'specialized' (default), or 'consensus'
MODEL_STRATEGY=specialized

# Default model family: claude, openai, gemini, deepseek, openrouter, xai
DEFAULT_MODEL_FAMILY=openrouter

# =============================================================================
# OPTIONAL: Storage & Output
# =============================================================================

STORAGE_PATH=./storage
REPORTS_PATH=./storage/reports

# =============================================================================
# OPTIONAL: Google PageSpeed Insights
# =============================================================================
# For performance analysis without CF screenshots.
# Get a free key at https://console.cloud.google.com/apis/credentials
# Enable "PageSpeed Insights API" in your GCP project

# GOOGLE_PSI_API_KEY=your_psi_key
