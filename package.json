    "packages/worker/uilensai/utils/presets/*.js",
    "!packages/worker/uilensai/utils/presets/*.bak",
    "packages/worker/uilensai/utils/prompts/*.js",
    "packages/worker/uilensai/utils/recommendations/*.js",
    "packages/worker/uilensai/storage/index.js",
